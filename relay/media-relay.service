[Unit]
Description=Atlas streaming-check relay
After=network-online.target monitor-hub.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/media-relay/media-relay.py
Environment=PORT=28090 HUB=http://127.0.0.1:28080
# Node tokens and addresses: read by systemd as root, handed to the service privately.
LoadCredential=tokens:/etc/media-relay/tokens.json
LoadCredential=nodes:/etc/media-relay/nodes.json
DynamicUser=yes
StateDirectory=media-relay
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
